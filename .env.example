APP_NAME="PHP MVC Starter"
APP_ENV=local
APP_URL=http://localhost
APP_DEBUG=true

# Mercado Pago (checkout hospedado)
# TESTE: use o Access Token de teste (comeca com TEST-) em Credenciais de teste.
# PRODUCAO: use o Access Token de producao (APP_USR-) e APP_URL com HTTPS.
# O webhook (/webhook/mercadopago) precisa de URL HTTPS publica; em localhost use
# um tunel (ex.: ngrok http 80) e coloque a URL do tunel em APP_URL. Sem tunel, o
# checkout de teste ainda funciona e o retorno sincroniza o pagamento sozinho.
# Chave secreta do webhook: painel > Webhooks > Configurar notificacoes (evento "Pagamentos").
# Chave publica (PIX nao precisa; cartao sim). Credenciais de teste -> Public Key (TEST-...)
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=root
DB_PASSWORD=

# Tamanho maximo (MB) de cada arquivo que o aluno anexa numa entrega de tarefa
# (tambem vale para imagens de slide da apresentacao).
UPLOAD_MAX_MB=10

# Tamanho maximo (MB) de um arquivo de video enviado num slide da apresentacao.
UPLOAD_VIDEO_MAX_MB=40

# Recorte de video dos slides (opcional). Se o ffmpeg nao estiver instalado, o
# recorte fica desabilitado; o resto do sistema continua funcionando.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_MAX_DUR=900

# Assistente de IA (Anthropic / Claude)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=8192

# Reaproveita a resposta de um pedido identico (mesmo modelo + mesmo prompt),
# sem chamar a API de novo. Vale para conteudo de aula e plano de aula.
AI_CACHE=true

# CAIXA de IA do sistema: quanto pode ser gasto NO TOTAL, somando todas as
# contas. Existe uma unica chave de API, entao e este limite que protege a
# fatura. Atingido o valor, ninguem gera ate o administrador aumentar.
# 0 = sem limite. Respostas servidas do cache custam zero e nao somam aqui.
AI_TETO_TOTAL_USD=20.00

# Teto adicional POR PROFESSOR, em USD. Impede que uma pessoa sozinha esvazie
# o caixa comum. 0 = desligado (todos usam livremente do caixa).
AI_TETO_USD=0

# LGPD: dados exibidos nas Politicas de Privacidade/Cookies (preencha antes de ir ao ar)
LGPD_CONTROLADOR=
LGPD_CNPJ=
LGPD_CONTATO_EMAIL=
LGPD_ENCARREGADO=

# E-mail (verificacao de cadastro e recuperacao de senha). 587 = STARTTLS (tls), 465 = SSL (ssl).
# Sem MAIL_HOST em desenvolvimento, o e-mail vai para storage/logs/mail-AAAA-MM-DD.log.
# Em producao, configure o SMTP e o APP_URL (usado para montar o link do e-mail).
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=
