APP_NAME="PHP MVC Starter"
APP_ENV=local
APP_URL=http://localhost
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=root
DB_PASSWORD=

# Assistente de IA (Anthropic / Claude)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=8192

# Reaproveita a resposta de um pedido identico (mesmo modelo + mesmo prompt),
# sem chamar a API de novo. Vale para conteudo de aula e plano de aula.
AI_CACHE=true

# CAIXA de IA do sistema: quanto pode ser gasto NO TOTAL, somando todas as
# contas. Existe uma unica chave de API, entao e este limite que protege a
# fatura. Atingido o valor, ninguem gera ate o administrador aumentar.
# 0 = sem limite. Respostas servidas do cache custam zero e nao somam aqui.
AI_TETO_TOTAL_USD=20.00

# Teto adicional POR PROFESSOR, em USD. Impede que uma pessoa sozinha esvazie
# o caixa comum. 0 = desligado (todos usam livremente do caixa).
AI_TETO_USD=0
